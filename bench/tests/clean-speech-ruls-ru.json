        "clean",
        "read-speech",
        "real-speech"
      ],
      "source": "librispeech"
    },
    {
      "id": "ruls-poemi_15_pushkin_0154",
      "audioFile": "samples-ruls-ru/poemi_15_pushkin_0154.wav",
      "groundTruth": "луна зашла в туманы, Чуть брезжит звезд неверный свет, Чуть по росе приметный след Ведет за дальные курганы: Нетерпеливо он идет, Куда зловещий след ведет.",
