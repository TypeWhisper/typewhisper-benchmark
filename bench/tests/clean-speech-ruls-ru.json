        "clean",
        "read-speech",
        "real-speech"
      ],
      "source": "librispeech"
    },
    {
      "id": "ruls-poemi_11_pushkin_0014",
      "audioFile": "samples-ruls-ru/poemi_11_pushkin_0014.wav",
      "groundTruth": "И смолкнул ярый крик войны: Все русскому мечу подвластно.",
