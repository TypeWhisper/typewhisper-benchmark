      "source": "librispeech"
    },
    {
      "id": "ruls-poemi_09_pushkin_0034",
      "audioFile": "samples-ruls-ru/poemi_09_pushkin_0034.wav",
      "groundTruth": "Раскрыв уста, без слез рыдая, Сидела дева молодая.",
      "tags": [
        "clean",
        "read-speech",
        "real-speech"
      ],
      "source": "librispeech"
    },
    {
      "id": "ruls-poemi_09_pushkin_0048",
      "audioFile": "samples-ruls-ru/poemi_09_pushkin_0048.wav",
      "groundTruth": "Нет, я не знал любви взаимной, Любил один, страдал один",
