      "source": "librispeech"
    },
    {
      "id": "ruls-poemi_11_pushkin_0033",
      "audioFile": "samples-ruls-ru/poemi_11_pushkin_0033.wav",
      "groundTruth": "Или по топким берегам, В траве высокой, в чаще леса Рассыпавшись, добычи ждут Скалы свободы их приют.",
      "tags": [
        "clean",
        "read-speech",
        "real-speech"
