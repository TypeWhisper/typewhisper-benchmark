# Cloud API Keys
OPENAI_API_KEY=sk-...
DEEPGRAM_API_KEY=
GROQ_API_KEY=gsk_...

# Local Providers (optional)
WHISPER_CPP_PATH=whisper-cli
WHISPER_CPP_MODELS_PATH=models

# SherpaOnnx (optional, local)
SHERPA_ONNX_MODELS_PATH=models/sherpa-onnx
SHERPA_ONNX_THREADS=

# AuroraASR (optional, local; needs uv)
AURORA_ASR_MODELS_PATH=models/aurora-asr
AURORA_ASR_THREADS=

# FluidAudio (optional, local; Apple Silicon, macOS 15+, Swift 6.2)
# Parakeet v2/v3/Ultra download on first use; community models via
# bash bench/scripts/download-fluidaudio-models.sh
FLUIDAUDIO_MODELS_PATH=models/fluidaudio

# Underdog Bark 3.0 / 3.0 Plus on Core ML, Bark 3.0 on MLX (optional, local; Apple Silicon, needs uv)
# bash bench/scripts/download-bark-models.sh
BARK_MODELS_PATH=models/bark

# CrispASR: Cohere Transcribe GGUF, as TypeWhisper's Cohere Transcribe (Local) plugin runs it
# (optional, local; Apple Silicon). bash bench/scripts/download-crispasr-models.sh
CRISPASR_MODELS_PATH=models/crispasr

# Kyutai STT on MLX (optional, local; Apple Silicon, needs uv). Weights download on first use.
KYUTAI_UV_PATH=uv

# Audio language models on mlx-vlm, such as LFM3-Audio (optional, local; Apple Silicon, needs uv).
# Weights download on first use.
MLX_VLM_UV_PATH=uv
