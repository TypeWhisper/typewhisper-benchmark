    },
    {
      "id": "ruls-poemi_09_pushkin_0030",
      "audioFile": "samples-ruls-ru/poemi_09_pushkin_0030.wav",
      "groundTruth": "Повсюду он со мною бродит И мрачную тоску наводит На душу сирую мою.",
      "tags": [
        "clean",
        "read-speech",
        "real-speech"
