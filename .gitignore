.DS_Store

# Run artifacts are immutable build outputs and must not be committed by accident.
artifacts/

# Audio enters the repository only after review and an explicit force-add.
corpus/audio/*
!corpus/audio/.gitkeep

# Raw recording uploads stay local until they have been reviewed and admitted.
corpus/inbox/**
!corpus/inbox/README.md
