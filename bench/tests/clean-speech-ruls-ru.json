        "clean",
        "read-speech",
        "real-speech"
      ],
      "source": "librispeech"
    },
    {
      "id": "ruls-poemi_11_pushkin_0031",
      "audioFile": "samples-ruls-ru/poemi_11_pushkin_0031.wav",
      "groundTruth": "Пищаль, кольчуга, сабля, лук И конь - соратник быстроногий - Их и сокровища и боги",
