    },
    {
      "id": "ruls-poemi_11_pushkin_0008",
      "audioFile": "samples-ruls-ru/poemi_11_pushkin_0008.wav",
      "groundTruth": "Тебя я воспою, герой, О Котляревский, бич Кавказа!",
