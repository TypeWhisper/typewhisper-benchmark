# Common Voice clips: the Mozilla Data Collective terms forbid re-sharing them. Rebuilt by
# bench/scripts/curate-common-voice.ts (accented speech), curate-commonvoice-en.py and curate-russian.py
bench/audio/samples-accent-en/
bench/audio/samples-accent-de/
bench/audio/samples-commonvoice-en/
bench/audio/samples-commonvoice-ru/

# French, Spanish, Italian, Portuguese and Dutch clips: rebuilt by bench/scripts/curate-romance.py
bench/audio/samples-*-fr/
bench/audio/samples-*-es/
bench/audio/samples-*-it/
bench/audio/samples-*-pt/
bench/audio/samples-*-nl/
# TTS dictation is committed: legal in every language, medical in Dutch too
!bench/audio/samples-legal-dictation-*/
!bench/audio/samples-medical-dictation-nl/
